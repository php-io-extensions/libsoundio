{
    "name": "php-io-extensions/libsoundio",
    "type": "php-ext",
    "description": "1:1 PHP bindings of libsoundio 2.0: backends, devices, channel layouts, formats, output and input streams, ring buffers",
    "keywords": [
        "libsoundio",
        "audio",
        "php-ext"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "pestphp/pest": "^4.0"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "0.11.x-dev"
        },
        "venusian": {
            "system": {
                "apt": {
                    "depends": [
                        "libsoundio2"
                    ]
                },
                "brew": {
                    "build": [
                        "libsoundio"
                    ]
                }
            }
        }
    },
    "php-ext": {
        "extension-name": "libsoundio",
        "priority": 30,
        "support-zts": true,
        "support-nts": true,
        "os-families": [
            "linux",
            "darwin"
        ],
        "configure-options": [
            {
                "name": "with-libsoundio",
                "description": "Enable the libsoundio extension; the value is the prefix holding include/soundio/soundio.h",
                "needs-value": false
            }
        ]
    }
}
